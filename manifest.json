{
  "manifest_version": 3,
  "name": "Screen Clip Reader",
  "version": "1.0.0",
  "description": "Crop anything visible in Chrome, copy it as an image, or extract text locally with OCR.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Screen Clip Reader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*", "tessdata/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
